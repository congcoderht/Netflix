// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  USER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum ContentType {
  MOVIE
  SERIES
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationType {
  NEW_MOVIE       // phim mới được thêm
  NEW_EPISODE     // tập mới của series
  SUBSCRIPTION    // sắp hết hạn, đã gia hạn
  SYSTEM          // thông báo hệ thống
}

// ============================================================
// AUTH
// ============================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatar    String?
  password  String?
  role      Role     @default(USER)
  isBlocked Boolean  @default(false) @map("is_blocked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  oauthAccounts  OAuthAccount[]
  refreshTokens  RefreshToken[]
  subscriptions  Subscription[]
  payments       Payment[]
  watchHistories WatchHistory[]
  watchProgresses WatchProgress[]
  watchList      WatchList[]
  comments       Comment[]
  ratings        Rating[]
  notifications  Notification[]

  @@map("users")
}

model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  accessToken       String?       @map("access_token")
  createdAt         DateTime      @default(now()) @map("created_at")

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============================================================
// MOVIE
// ============================================================

model Genre {
  id     String         @id @default(uuid())
  name   String         @unique
  movies GenreOnMovie[]

  @@map("genres")
}

model Movie {
  id          String      @id @default(uuid())
  title       String
  description String?
  thumbnail   String?
  trailerUrl  String?     @map("trailer_url")
  type        ContentType @default(MOVIE)
  isPublished Boolean     @default(false) @map("is_published")

  // Chỉ dùng khi type = MOVIE
  videoUrl    String?     @map("video_url")
  duration    Int?        // phút

  // Chỉ dùng khi type = SERIES
  seasons     Season[]

  genres      GenreOnMovie[]
  watchHistories WatchHistory[]
  watchProgresses WatchProgress[]
  watchList   WatchList[]
  comments    Comment[]
  ratings     Rating[]

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("movies")
}

model GenreOnMovie {
  movieId String @map("movie_id")
  genreId String @map("genre_id")

  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@map("genre_on_movies")
}

model Season {
  id        String    @id @default(uuid())
  movieId   String    @map("movie_id")
  number    Int
  title     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodes  Episode[]

  @@unique([movieId, number])
  @@map("seasons")
}

model Episode {
  id        String   @id @default(uuid())
  seasonId  String   @map("season_id")
  number    Int
  title     String
  videoUrl  String?  @map("video_url")
  duration  Int?     // phút
  thumbnail String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchHistories WatchHistory[]
  watchProgresses WatchProgress[]

  @@unique([seasonId, number])
  @@map("episodes")
}

// ============================================================
// SUBSCRIPTION & PAYMENT
// ============================================================

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique  // Basic, Standard, Premium
  price       Float
  description String?
  maxScreens  Int      @default(1) @map("max_screens")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  planId    String             @map("plan_id")
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now()) @map("started_at")
  expiresAt DateTime           @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Payment {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  planId    String        @map("plan_id")
  amount    Float
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan          @relation(fields: [planId], references: [id])

  @@map("payments")
}

// ============================================================
// WATCH ACTIVITY
// ============================================================

model WatchHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  episodeId String?  @map("episode_id") // null nếu là phim lẻ
  watchedAt DateTime @default(now()) @map("watched_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@map("watch_histories")
}

model WatchProgress {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  movieId     String   @map("movie_id")
  episodeId   String?  @map("episode_id") // null nếu là phim lẻ
  progressSec Int      @default(0) @map("progress_sec") // giây đã xem đến
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode     Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@unique([userId, movieId, episodeId])
  @@map("watch_progresses")
}

model WatchList {
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@map("watch_list")
}

// ============================================================
// COMMENT & RATING
// ============================================================

model Comment {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  movieId   String    @map("movie_id")
  parentId  String?   @map("parent_id") // null = comment gốc, có giá trị = reply
  content   String
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  @@map("comments")
}

model Rating {
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  score     Int      // 1 - 5
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@map("ratings")
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
