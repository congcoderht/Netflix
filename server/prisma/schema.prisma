// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  USER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum ContentType {
  MOVIE
  SERIES
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
}

enum NotificationType {
  NEW_MOVIE       // phim mới được thêm
  NEW_EPISODE     // tập mới của series
  SUBSCRIPTION    // sắp hết hạn, đã gia hạn
  SYSTEM          // thông báo hệ thống
}

// ============================================================
// AUTH
// ============================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatar    String?
  password  String?
  role      Role     @default(USER)
  isBlocked Boolean  @default(false) @map("is_blocked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  oauthAccounts  OAuthAccount[]
  refreshTokens  RefreshToken[]
  subscriptions  Subscription[]
  payments       Payment[]
  watchHistories WatchHistory[]
  watchProgresses WatchProgress[]
  watchList      WatchList[]
  comments       Comment[]
  ratings        Rating[]
  notifications  Notification[]
  playbackSessions PlaybackSession[]

  @@map("users")
}

model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  accessToken       String?       @map("access_token")
  createdAt         DateTime      @default(now()) @map("created_at")

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  tokenHash           String    @unique @map("token_hash")
  familyId            String    @map("family_id")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  revokedAt           DateTime? @map("revoked_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// ============================================================
// MOVIE
// ============================================================

model Genre {
  id     String         @id @default(uuid())
  name   String         @unique
  movies GenreOnMovie[]

  @@map("genres")
}

model Actor {
  id        String         @id @default(uuid())
  name      String
  avatar    String?
  bio       String?
  createdAt DateTime       @default(now()) @map("created_at")
  movies    ActorOnMovie[]

  @@map("actors")
}

model Movie {
  id          String      @id @default(uuid())
  title       String
  description String?
  thumbnail   String?
  trailerUrl  String?     @map("trailer_url")
  type        ContentType @default(MOVIE)
  isPublished Boolean     @default(false) @map("is_published")

  // Chỉ dùng khi type = MOVIE
  videoUrl    String?     @map("video_url")
  duration    Int?        // phút

  // Chỉ dùng khi type = SERIES
  seasons     Season[]

  genres      GenreOnMovie[]
  actors      ActorOnMovie[]
  watchHistories WatchHistory[]
  watchProgresses WatchProgress[]
  watchList   WatchList[]
  comments    Comment[]
  ratings     Rating[]

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("movies")
}

model GenreOnMovie {
  movieId String @map("movie_id")
  genreId String @map("genre_id")

  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@map("genre_on_movies")
}

model ActorOnMovie {
  movieId String @map("movie_id")
  actorId String @map("actor_id")
  role    String?

  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  actor   Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@id([movieId, actorId])
  @@map("actor_on_movies")
}

model Season {
  id        String    @id @default(uuid())
  movieId   String    @map("movie_id")
  number    Int
  title     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodes  Episode[]

  @@unique([movieId, number])
  @@map("seasons")
}

model Episode {
  id        String   @id @default(uuid())
  seasonId  String   @map("season_id")
  number    Int
  title     String
  videoUrl  String?  @map("video_url")
  duration  Int?     // phút
  thumbnail String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchHistories WatchHistory[]
  watchProgresses WatchProgress[]

  @@unique([seasonId, number])
  @@map("episodes")
}

// ============================================================
// SUBSCRIPTION & PAYMENT
// ============================================================

model Plan {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String   @unique
  price       Int
  currency    String   @default("VND")
  durationDays Int     @default(30) @map("duration_days")
  description String?
  maxScreens  Int      @default(1) @map("max_screens")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  planId    String             @map("plan_id")
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now()) @map("started_at")
  expiresAt DateTime           @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])
  payments  Payment[]

  @@index([userId, status, expiresAt])
  @@map("subscriptions")
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String        @map("user_id")
  planId                String        @map("plan_id")
  subscriptionId        String?       @map("subscription_id")
  orderId               String        @unique @map("order_id")
  requestId             String        @unique @map("request_id")
  providerTransactionId String?       @unique @map("provider_transaction_id")
  provider              String        @default("MOMO")
  amount                Int
  currency              String        @default("VND")
  planName              String        @map("plan_name")
  durationDays          Int           @map("duration_days")
  status                PaymentStatus @default(PENDING)
  failureCode           String?       @map("failure_code")
  failureMessage        String?       @map("failure_message")
  paymentUrl            String?       @map("payment_url")
  expiresAt             DateTime      @map("expires_at")
  paidAt                DateTime?     @map("paid_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("payments")
}

model PlaybackSession {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  deviceId      String    @map("device_id")
  movieId       String    @map("movie_id")
  episodeId     String?   @map("episode_id")
  startedAt     DateTime  @default(now()) @map("started_at")
  lastHeartbeat DateTime  @default(now()) @map("last_heartbeat")
  endedAt       DateTime? @map("ended_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt, lastHeartbeat])
  @@index([deviceId])
  @@map("playback_sessions")
}

// ============================================================
// WATCH ACTIVITY
// ============================================================

model WatchHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  episodeId String?  @map("episode_id") // null nếu là phim lẻ
  watchedAt DateTime @default(now()) @map("watched_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([userId, watchedAt])
  @@map("watch_histories")
}

model WatchProgress {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  movieId     String   @map("movie_id")
  episodeId   String?  @map("episode_id") // null nếu là phim lẻ
  progressSec Int      @default(0) @map("progress_sec") // giây đã xem đến
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode     Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@unique([userId, movieId, episodeId])
  @@map("watch_progresses")
}

model WatchList {
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@map("watch_list")
}

// ============================================================
// COMMENT & RATING
// ============================================================

model Comment {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  movieId   String    @map("movie_id")
  parentId  String?   @map("parent_id") // null = comment gốc, có giá trị = reply
  content   String
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  @@index([movieId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model Rating {
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  score     Int      // 1 - 5
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([movieId])
  @@map("ratings")
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
