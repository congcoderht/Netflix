PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netflix_db
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379

# Local-only payment simulator. The server refuses to start with mock mode in production.
PAYMENT_MODE=mock
MOCK_PAYMENT_SECRET=replace-with-a-long-random-local-secret
MOCK_PAYMENT_URL=http://localhost:5173/mock-payment
PAYMENT_RESULT_URL=http://localhost:5173/payment/result
