PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netflix_db
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379

# Optional Google OAuth. Leave both credentials empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email provider used for OTP and account emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Netflix <no-reply@example.com>"

# Cloudinary media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mock payment is used for this demo deployment.
PAYMENT_MODE=mock
MOCK_PAYMENT_SECRET=replace-with-a-long-random-local-secret
MOCK_PAYMENT_URL=http://localhost:5173/mock-payment
PAYMENT_RESULT_URL=http://localhost:5173/payment/result

